{
  "name": "anthony-narine-engineering-handbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "validate": "node scripts/content.mjs",
    "typecheck": "tsc --noEmit",
    "build": "npm run validate && npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:browser": "node tests/browser.mjs",
    "review:projects": "node scripts/review-projects.mjs",
    "check:public": "node scripts/check-public.mjs",
    "build:release": "npm audit --audit-level=high && npm run build && node scripts/write-release.mjs && npm run check:public && node scripts/check-public.mjs --dist",
    "test:release": "node tests/release-integrity.mjs && node scripts/build-security-fixture.mjs && node scripts/run-browser-checks.mjs",
    "release:prepare": "node scripts/prepare-release.mjs",
    "release:deploy": "node scripts/deploy-release.mjs",
    "check:production": "node scripts/check-production.mjs",
    "build:art": "npm run validate && npm run typecheck && node scripts/build-brain-art.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "mermaid": "^11.17.2",
    "minisearch": "^7.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router": "^7.9.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.1.0",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "katex": "^0.19.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
